# VITE_AI_WORKER_URL: URL Cloudflare Worker (Gemini-прокси).
# В dev оставить пустым — Vite proxy перенаправит /api → Worker (localhost:8787).
# В prod — https://rezept-manager-ai-proxy.<account>.workers.dev
VITE_AI_WORKER_URL=""

# Firebase web app config. Берётся в Firebase Console → Project Settings → General → Your apps.
# Эти значения не являются секретами (они встраиваются в клиентский бандл),
# но держим их в env, чтобы легко переключать проекты (dev/staging/prod).
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="my-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-project"
VITE_FIREBASE_STORAGE_BUCKET="my-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
